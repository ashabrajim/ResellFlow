# Copiez ce fichier en `.env` (jamais commité). Toutes les clés sont lues côté serveur uniquement.

# Import automatique Taobao + Weidian (variantes, prix par variante) via Apify.
# Jeton : console.apify.com > Settings > API & Integrations.
APIFY_API_TOKEN=
# Plafond d'imports automatiques par jour (maîtrise du coût). Défaut : 300.
APIFY_DAILY_LIMIT=300

# Traduction en français (sans clé : MyMemory gratuit, quota limité, qualité moyenne).
DEEPL_API_KEY=
# GOOGLE_TRANSLATE_API_KEY=

# Secours anti-robot pour les autres plateformes (optionnel).
FIRECRAWL_API_KEY=
